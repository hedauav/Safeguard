# ===========================================
# SAFEGUARD FRONTEND ENVIRONMENT
# Copy to frontend/.env and fill in.
#
# Everything here is bundled into the client build and is publicly visible.
# Never put a service role key or a private key in this file.
# ===========================================

# Base URL of the SafeGuard backend.
# Local: http://localhost:3005
# Production: your Railway backend URL, e.g. https://safeguard-backend.up.railway.app
VITE_API_URL=http://localhost:3005

# Supabase project URL and ANON key (not the service role key).
# Used for the dashboard's realtime claim/call subscriptions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ElevenLabs agent id for the in-browser voice widget.
# Leave blank to disable browser calling — the widget then renders a notice
# rather than silently connecting to an unrelated agent.
VITE_ELEVENLABS_AGENT_ID=
