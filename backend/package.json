{
  "name": "safeguard-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "check:setup": "node scripts/check-setup.mjs",
    "check:drift": "node ../scripts/check-drift.mjs",
    "check:numbers": "node ../scripts/check-numbers.mjs",
    "stamp:version": "node scripts/stamp-version.mjs",
    "deploy": "node scripts/stamp-version.mjs && railway up --service safeguard-api --detach && git checkout -- src/generated/version.ts",
    "deploy:registry": "node scripts/deploy-registry.mjs ClaimRegistry",
    "deploy:registry:v2": "node scripts/deploy-registry.mjs ClaimRegistryV2",
    "setup:elevenlabs": "node scripts/setup-elevenlabs.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "matrix": "node scripts/functionality-matrix.mjs",
    "ablate": "node scripts/ablate.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "^2.7.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@filoz/synapse-core": "^0.2.3",
    "@filoz/synapse-sdk": "^0.38.0",
    "@supabase/supabase-js": "^2.45.0",
    "chrono-node": "^2.9.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.12.1",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "unpdf": "^1.8.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "solc": "^0.8.36",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0"
  }
}
