# ===========================================
# SAFEGUARD BACKEND ENVIRONMENT
# Copy to backend/.env and fill in.
# Never commit the filled-in file.
# ===========================================

# -------------------------------------------
# REQUIRED — the server will not start without these
# -------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (Project Settings -> API -> service_role).
# This bypasses row level security. Server-side only, never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=


# -------------------------------------------
# STRONGLY RECOMMENDED
# -------------------------------------------

# Shared secret from the ElevenLabs post-call webhook settings.
# In production, an unset value REFUSES every post-call webhook (503) rather
# than processing it unverified — that handler writes the call log, the
# transcript and the tool-execution rows that make up the compliance record.
# In development an unset value falls open with a warning so the post-call path
# stays testable. /health reports security.webhook_signature as one of
# enforced / development-bypass / fail-closed.
ELEVENLABS_WEBHOOK_SECRET=

# Shared secret guarding everything the voice agent calls: /api/tools/*,
# /api/elevenlabs/conversation-init and POST /api/calls/:id/tool-executions.
# Those endpoints spend real testnet funds (a Filecoin upload and a Base
# Sepolia write on every filing), release payouts, return customer PII, and
# write the audit trail — so in production an unset value DISABLES them (503)
# rather than leaving them open. In development an unset value falls open with
# a warning. /health reports security.tools_authentication as one of
# enforced / development-bypass / fail-closed.
#
# Any sufficiently long random string, e.g. `openssl rand -hex 32`.
# Send it as the `x-tools-token` header, or `Authorization: Bearer <token>`.
# `npm run setup:elevenlabs` and the dashboard's sync both configure this value
# as a request header on the agent's webhook tools, so set it here BEFORE
# syncing or the live agent will be locked out.
#
# The evaluation harness calls the same endpoints and needs the same value:
#   TOOLS_API_TOKEN=... npm run evaluate
# The ablation harness (`npm run ablate`) starts its own local server and calls
# the tools without a header, so run it with NODE_ENV=development and this
# blank: `TOOLS_API_TOKEN= npm run ablate`.
TOOLS_API_TOKEN=


# -------------------------------------------
# AGENT CONFIGURATION — needed to provision or edit the voice agent
#
# All three together enable agent config sync; /health reports
# agent_config_sync=disabled when any is missing. The backend serves calls
# without them, but `npm run setup:elevenlabs` and the dashboard's Agent
# Config editor will not work.
# -------------------------------------------

# ElevenLabs API key (Profile -> API Keys). Server-side only.
ELEVENLABS_API_KEY=

# The agent to configure, e.g. agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_ID=

# Shared secret guarding the agent-config write endpoints. Any sufficiently
# long random string. Without it those endpoints are disabled, not open.
ADMIN_TOKEN=


# -------------------------------------------
# SERVER
# -------------------------------------------
PORT=3005

# Decides what a missing secret means. 'production' fails closed: the webhook
# and tool endpoints refuse rather than fall open. Anything else fails open
# with warnings, and additionally allows any localhost origin through CORS.
NODE_ENV=development

# The single browser origin allowed to make credentialed requests — the
# deployed dashboard. Scheme, host and port only; the path is ignored. Any
# other Origin gets no CORS headers back, so a page on another site cannot
# read this API with the visitor's credentials. Localhost is additionally
# allowed whenever NODE_ENV is not 'production'.
FRONTEND_URL=http://localhost:5173

# Per-IP request ceilings, all per minute. Blank or unparseable falls back to
# the default; a value below 1 is treated as a mistake and ignored, because a
# limit of zero would block every request.
#
# Everything, /health and /version excepted. Default 300.
RATE_LIMIT_MAX=
# The agent-facing routes: /api/tools/*, conversation-init, the audit write.
# Sized for ElevenLabs' shared egress addresses, where one IP carries every
# concurrent conversation. Default 120.
RATE_LIMIT_TOOLS_MAX=
# The routes that spend or move money: file-claim (Filecoin + Base Sepolia),
# settle-claim, offer-renewal, escalate-to-regulator (EAS), and
# adjudicate-claim (metered model tokens). No real phone conversation reaches
# this rate. Default 15.
RATE_LIMIT_ONCHAIN_MAX=

# Largest claim settlement the agent may release without a human. Anything
# above it is refused and routed for authorisation. Defaults to 50000 when
# blank or unparseable — the ceiling is never silently removed.
SETTLEMENT_AUTO_APPROVE_LIMIT=


# -------------------------------------------
# POLICY RENEWAL PAYMENT LINKS
#
# When a caller acts on a lapsed policy the agent refuses the claim and offers
# a payment link for the premium owed instead. With the two Razorpay keys set,
# the link is real; without them a clearly-labelled simulated link is issued
# whose URL resolves nowhere. /health reports which is in use. Nothing is faked
# as real either way.
# -------------------------------------------

# Razorpay API key id (Dashboard -> Account & Settings -> API Keys).
# Test keys start with rzp_test. Payment links need only a standard key;
# payouts would need RazorpayX and are not used here.
RAZORPAY_KEY_ID=

# The matching key secret. Server-side only, never expose to a browser and
# never commit the filled-in file.
RAZORPAY_KEY_SECRET=

# Secret Razorpay signs webhook deliveries with. Set separately in the
# dashboard against the webhook itself (Settings -> Webhooks), NOT derived from
# the key pair above. Subscribe the webhook to `payment_link.paid` and point it
# at POST /api/webhooks/razorpay.
#
# Without this, deductible captures cannot be verified. In production the
# endpoint refuses every delivery rather than believe an unsigned one, because
# a recorded capture is what a later refund is made against. In development it
# falls open with a warning so the path is testable.
RAZORPAY_WEBHOOK_SECRET=

# A second, EARLIER Razorpay test account, read only and optional.
#
# Part of the book was collected before the current account existed. A key
# can only read the account it belongs to, so /api/evidence/verify reports
# those payments as "not on this account" without these. Setting them lets
# the public verification endpoint confirm them too.
#
# Read-only by wiring: consumed in src/routes/verify.ts and nowhere else,
# which issues GETs only. Never wire these into anything that creates a
# payment link or a refund.
RAZORPAY_ARCHIVE_KEY_ID=
RAZORPAY_ARCHIVE_KEY_SECRET=

# Ceiling on a deductible the agent may put behind a payment link unaided, in
# rupees. Above it the demand is refused and routed to a human. The deductible
# itself is always read from policies.deductible; this only bounds it.
# Defaults to 100000 when blank or unparseable.
DEDUCTIBLE_MAX_LINK_AMOUNT=

# Policy term a renewal covers, in months. The premium is multiplied by this
# server-side; the agent never supplies a term. Defaults to 12 when blank or
# unparseable.
RENEWAL_TERM_MONTHS=

# Largest renewal the agent may put behind a payment link without a human.
# Anything above it is refused and routed to a representative. Defaults to
# 200000 when blank or unparseable — the ceiling is never silently removed.
RENEWAL_MAX_LINK_AMOUNT=


# -------------------------------------------
# AI CLAIM ADJUDICATION
#
# POST /api/tools/adjudicate-claim reads a policy, a claim and the text of the
# documents attached to it, and recommends whether the claim is payable. It is
# a recommendation: nothing it produces approves a claim, changes a status, or
# releases a payout, and the payable figure is always computed in code rather
# than taken from the model.
#
# Without a key the endpoint still runs every deterministic check — lapsed
# policy, uncovered claim type, amount over the limit, already-decided claim,
# near-duplicate — and then escalates, saying plainly that no model read the
# documents. The startup log reports which model is in use. Nothing is faked.
# -------------------------------------------

# Groq API key (console.groq.com -> API Keys). Server-side only.
GROQ_API_KEY=

# Model id for adjudication. Not validated against Groq's catalogue: a wrong id
# fails the call loudly and the claim escalates with the reason recorded, which
# beats maintaining a list here that goes stale. Defaults to
# openai/gpt-oss-120b when blank.
GROQ_MODEL=

# How long an adjudication waits for the model before escalating. The caller is
# on the phone. Defaults to 20000 (ms) when blank or unparseable.
ADJUDICATION_TIMEOUT_MS=


# -------------------------------------------
# OPTIONAL — evidence archival and on-chain attestation
#
# Every value below is optional. Leave them blank and the corresponding
# feature reports itself as disabled at /health; nothing is faked.
# -------------------------------------------

# Private key of the agent wallet, 0x-prefixed.
# Enables Filecoin uploads. Needs Filecoin Calibration tFIL and a funded USDFC
# payment rail for Warm Storage, plus Base Sepolia ETH for attestations.
# Use a fresh key generated for this purpose only. Never reuse a key that has
# ever appeared in source control.
AGENT_PRIVATE_KEY=

# Deployed ClaimRegistry (v1) address on Base Sepolia.
# Together with AGENT_PRIVATE_KEY this enables on-chain claim attestation, and
# it is what /health reads to report chain_attestation. Keep it set even when
# using v2 below.
# Deploy with: npm run deploy:registry
CLAIM_REGISTRY_ADDRESS=

# Deployed ClaimRegistryV2 address on Base Sepolia. Optional but recommended.
#
# v1 anchored a Filecoin CID, which meant attestation could only happen once an
# upload succeeded — an archival outage silently cost you the tamper-evidence
# guarantee for a bundle that had already been hashed correctly. v2 anchors the
# evidence hash itself and takes the storage locator as a separate, optional
# string, so a claim still gets a real on-chain proof when Filecoin is down;
# the CID is simply recorded as empty.
#
# When this is set the evidence pipeline writes here instead of v1. Leave it
# blank to keep the old v1 behaviour.
# Deploy with: npm run deploy:registry:v2
CLAIM_REGISTRY_V2_ADDRESS=

# RPCs. Public defaults are used when these are blank; set your own provider
# for reliability under load.
BASE_SEPOLIA_RPC_URL=
FILECOIN_RPC_URL=

# Ethereum Attestation Service. All three are needed together.
EAS_CONTRACT_ADDRESS=
EAS_SCHEMA_UID=
EAS_SCHEMA=

# ERC-8004 agent NFT id, shown on the dashboard identity card.
AGENT_ID=

# Not read by the backend (it uses the service role key). Kept for reference.
SUPABASE_ANON_KEY=


# -------------------------------------------
# DEMO MODE
# -------------------------------------------

# When 'true', Filecoin uploads and chain attestation return clearly-labelled
# simulated results instead of touching a network, and /health reports
# mode=simulation. Intended for demos and for running without a funded wallet.
# Leave blank for real behaviour.
SIMULATE_BLOCKCHAIN=


# -------------------------------------------
# SCRIPTS ONLY — not read by the server
# -------------------------------------------

# Target for `npm run evaluate` and `npm run setup:elevenlabs`.
# Defaults to the deployed Railway backend.
API_BASE_URL=

# Set to 'false' to stop `npm run setup:elevenlabs` overwriting the agent's
# system prompt and name. Anything else syncs them.
SYNC_PROMPT=
