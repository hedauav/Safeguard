# ===========================================
# SAFEGUARD BACKEND ENVIRONMENT
# Copy to backend/.env and fill in.
# Never commit the filled-in file.
# ===========================================

# -------------------------------------------
# REQUIRED — the server will not start without these
# -------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (Project Settings -> API -> service_role).
# This bypasses row level security. Server-side only, never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=


# -------------------------------------------
# STRONGLY RECOMMENDED
# -------------------------------------------

# Shared secret from the ElevenLabs post-call webhook settings.
# When unset, post-call webhooks are accepted WITHOUT signature verification,
# meaning anyone who knows the URL can write call records. Set this before
# pointing a real agent at this backend.
ELEVENLABS_WEBHOOK_SECRET=


# -------------------------------------------
# AGENT CONFIGURATION — needed to provision or edit the voice agent
#
# All three together enable agent config sync; /health reports
# agent_config_sync=disabled when any is missing. The backend serves calls
# without them, but `npm run setup:elevenlabs` and the dashboard's Agent
# Config editor will not work.
# -------------------------------------------

# ElevenLabs API key (Profile -> API Keys). Server-side only.
ELEVENLABS_API_KEY=

# The agent to configure, e.g. agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_AGENT_ID=

# Shared secret guarding the agent-config write endpoints. Any sufficiently
# long random string. Without it those endpoints are disabled, not open.
ADMIN_TOKEN=


# -------------------------------------------
# SERVER
# -------------------------------------------
PORT=3005
NODE_ENV=development
FRONTEND_URL=http://localhost:5173


# -------------------------------------------
# OPTIONAL — evidence archival and on-chain attestation
#
# Every value below is optional. Leave them blank and the corresponding
# feature reports itself as disabled at /health; nothing is faked.
# -------------------------------------------

# Private key of the agent wallet, 0x-prefixed.
# Enables Filecoin uploads. Needs Filecoin Calibration tFIL and a funded USDFC
# payment rail for Warm Storage, plus Base Sepolia ETH for attestations.
# Use a fresh key generated for this purpose only. Never reuse a key that has
# ever appeared in source control.
AGENT_PRIVATE_KEY=

# Deployed ClaimRegistry address on Base Sepolia.
# Together with AGENT_PRIVATE_KEY this enables on-chain claim attestation.
# Deploy with: cd contracts && forge script script/DeployClaimRegistry.s.sol \
#   --rpc-url $BASE_SEPOLIA_RPC_URL --broadcast
CLAIM_REGISTRY_ADDRESS=

# RPCs. Public defaults are used when these are blank; set your own provider
# for reliability under load.
BASE_SEPOLIA_RPC_URL=
FILECOIN_RPC_URL=

# Ethereum Attestation Service. All three are needed together.
EAS_CONTRACT_ADDRESS=
EAS_SCHEMA_UID=
EAS_SCHEMA=

# ERC-8004 agent NFT id, shown on the dashboard identity card.
AGENT_ID=

# Not read by the backend (it uses the service role key). Kept for reference.
SUPABASE_ANON_KEY=


# -------------------------------------------
# DEMO MODE
# -------------------------------------------

# When 'true', Filecoin uploads and chain attestation return clearly-labelled
# simulated results instead of touching a network, and /health reports
# mode=simulation. Intended for demos and for running without a funded wallet.
# Leave blank for real behaviour.
SIMULATE_BLOCKCHAIN=


# -------------------------------------------
# SCRIPTS ONLY — not read by the server
# -------------------------------------------

# Target for `npm run evaluate` and `npm run setup:elevenlabs`.
# Defaults to the deployed Railway backend.
API_BASE_URL=

# Set to 'false' to stop `npm run setup:elevenlabs` overwriting the agent's
# system prompt and name. Anything else syncs them.
SYNC_PROMPT=
